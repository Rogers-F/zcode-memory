{
  "name": "zcode-memory",
  "version": "0.3.1",
  "description": "Portable, local-first Markdown memory with six host adapters",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/core/index.cjs",
  "bin": {
    "zcode-memory": "bin/zcode-memory.cjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node scripts/test.cjs unit",
    "test:integration": "node scripts/test.cjs integration",
    "test:hosts": "node scripts/host-check.cjs",
    "build": "node scripts/build.cjs",
    "pack": "node scripts/build.cjs --pack",
    "check": "node scripts/check.cjs && npm run release:check",
    "verify": "npm run check && npm test && npm run test:integration && npm run pack && npm run test:package",
    "test:pi": "node scripts/pi-host-check.cjs",
    "test:cli": "node scripts/cli-host-check.cjs",
    "test:package": "node scripts/package-check.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "test:lifecycle": "node scripts/lifecycle-host-check.cjs",
    "release:check": "node scripts/release.cjs",
    "release:prepare": "node scripts/release.cjs --sync"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "files": [
    "src",
    "bin",
    "adapters",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "sources.json",
    "vendor",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "marketplaces",
    "docs"
  ],
  "devDependencies": {
    "marked": "18.0.11"
  },
  "pi": {
    "extensions": [
      "./adapters/pi-cli/index.ts"
    ]
  },
  "bundledDependencies": [
    "yaml"
  ]
}
